# Optional. Leave empty if you do not intend to use online exchange rates.
# Must be served through a secure server-side proxy — never expose keys in the client bundle.
VITE_EXCHANGE_RATE_PROXY_URL=
# Optional — enables the online AI assistant via the serverless endpoint.
# Leave empty to run the assistant entirely offline (no API key required).
# The OpenAI key itself is set as a SERVER-SIDE env var in Vercel (OPENAI_API_KEY),
# never in this file and never exposed to the browser.

# Set this to your deployed function path if you want the browser to call it.
# In local dev with `vercel dev` it would be: http://localhost:3000/api/chat
VITE_ASSISTANT_ENDPOINT=